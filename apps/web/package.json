{
	"name": "@largerio/web",
	"version": "1.0.0",
	"private": true,
	"description": "SvelteKit frontend for Secret — encrypts notes and files in the browser (XChaCha20-Poly1305) before they ever reach the server. Consumes the @largerio/secret-sdk client.",
	"homepage": "https://github.com/largerio/secret#readme",
	"bugs": "https://github.com/largerio/secret/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/largerio/secret.git",
		"directory": "apps/web"
	},
	"license": "MIT",
	"author": "Larger.io",
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "NODE_ENV=production vite build && node scripts/bundle-manifest.ts",
		"preview": "vite preview",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
	},
	"dependencies": {
		"@cap.js/wasm": "^0.0.8",
		"@cap.js/widget": "^0.1.63",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@largerio/secret-sdk": "workspace:*",
		"@largerio/secret-shared": "workspace:*",
		"dompurify": "^3.5.0",
		"marked": "^18.2.1",
		"qrcode": "^1.5.4"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^26.6.6",
		"@types/qrcode": "^1.5.6",
		"jsdom": "^31.0.1",
		"jsqr": "^1.4.0",
		"svelte": "^5.59.1",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"vite": "^8.3.8"
	}
}
