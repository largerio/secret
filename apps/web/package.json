{
	"name": "@largerio/web",
	"version": "1.0.0",
	"private": true,
	"description": "SvelteKit frontend for Secret — encrypts notes and files in the browser (XChaCha20-Poly1305) before they ever reach the server. Consumes the @largerio/secret-sdk client.",
	"homepage": "https://github.com/largerio/secret#readme",
	"bugs": "https://github.com/largerio/secret/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/largerio/secret.git",
		"directory": "apps/web"
	},
	"license": "MIT",
	"author": "Larger.io",
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && tsc -p tsconfig.server.json",
		"preview": "vite preview",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.server.json --noEmit"
	},
	"dependencies": {
		"@cap.js/wasm": "^0.0.8",
		"@cap.js/widget": "^0.1.58",
		"@largerio/secret-sdk": "workspace:*",
		"@largerio/secret-shared": "workspace:*",
		"isomorphic-dompurify": "^4.5.0",
		"marked": "^18.0.14",
		"qrcode": "^1.5.4"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.3",
		"@types/qrcode": "^1.5.6",
		"jsdom": "^30.1.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.3.1"
	}
}
