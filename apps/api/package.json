{
	"name": "@largerio/api",
	"version": "1.0.0",
	"private": true,
	"description": "Hono API server for Secret — stores doubly encrypted notes and files (AES-256-GCM server layer), with OpenAPI docs, rate limiting, and pluggable local/S3 storage.",
	"homepage": "https://github.com/largerio/secret#readme",
	"bugs": "https://github.com/largerio/secret/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/largerio/secret.git",
		"directory": "apps/api"
	},
	"license": "MIT",
	"author": "Larger.io",
	"type": "module",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"build": "tsc",
		"db:generate": "drizzle-kit generate",
		"start": "node dist/index.js",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1106.0",
		"@aws-sdk/lib-storage": "^3.1106.0",
		"@cap.js/server": "^4.0.5",
		"@hono/node-server": "^2.1.0",
		"@hono/zod-openapi": "^1.5.2",
		"@largerio/secret-crypto": "workspace:*",
		"@largerio/secret-shared": "workspace:*",
		"@scalar/hono-api-reference": "^0.11.13",
		"drizzle-orm": "1.0.0-rc.4",
		"hono": "^4.13.1",
		"nanoid": "^6.0.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/node": "^26.2.0",
		"drizzle-kit": "1.0.0-rc.4",
		"tsx": "^4.23.12"
	}
}
