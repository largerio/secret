{
	"name": "@largerio/secret-sdk",
	"version": "1.1.1",
	"description": "JavaScript/TypeScript SDK for Secret — create, read, and delete zero-knowledge, end-to-end encrypted notes and files on any Secret instance.",
	"keywords": [
		"encryption",
		"zero-knowledge",
		"end-to-end-encryption",
		"e2ee",
		"secret",
		"secure-sharing",
		"privacy",
		"sdk",
		"typescript"
	],
	"homepage": "https://github.com/largerio/secret#readme",
	"bugs": "https://github.com/largerio/secret/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/largerio/secret.git",
		"directory": "packages/sdk-js"
	},
	"license": "MIT",
	"author": "Larger.io",
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": "./src/index.ts"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"import": "./dist/index.js"
			}
		}
	},
	"scripts": {
		"build": "tsup",
		"typecheck": "tsc --noEmit",
		"verify-package": "sh scripts/verify-package.sh"
	},
	"dependencies": {
		"@msgpack/msgpack": "^3.1.3",
		"libsodium-wrappers-sumo": "^0.8.4"
	},
	"devDependencies": {
		"@largerio/secret-crypto": "workspace:*",
		"@largerio/secret-shared": "workspace:*",
		"@types/node": "^26.1.1",
		"tsup": "^8.5.1"
	},
	"engines": {
		"node": ">=18"
	}
}
