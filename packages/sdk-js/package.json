{
	"name": "@largerio/secret-sdk",
	"version": "1.0.0",
	"description": "JavaScript/TypeScript SDK for Secret — create, read, and delete zero-knowledge, end-to-end encrypted notes and files on any Secret instance.",
	"keywords": [
		"encryption",
		"zero-knowledge",
		"end-to-end-encryption",
		"e2ee",
		"secret",
		"secure-sharing",
		"privacy",
		"sdk",
		"typescript"
	],
	"homepage": "https://github.com/largerio/secret#readme",
	"bugs": "https://github.com/largerio/secret/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/largerio/secret.git",
		"directory": "packages/sdk-js"
	},
	"license": "MIT",
	"author": "Larger.io",
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": "./src/index.ts"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"import": "./dist/index.js"
			}
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@largerio/secret-crypto": "workspace:*",
		"@largerio/secret-shared": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^25.9.1"
	}
}
