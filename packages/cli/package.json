{
	"name": "@largerio/secret-cli",
	"version": "0.0.0",
	"description": "Command-line client for Secret — send, read, check and delete zero-knowledge, end-to-end encrypted notes and files from your terminal.",
	"keywords": [
		"cli",
		"encryption",
		"zero-knowledge",
		"end-to-end-encryption",
		"e2ee",
		"secret",
		"secure-sharing",
		"privacy"
	],
	"homepage": "https://github.com/largerio/secret#readme",
	"bugs": "https://github.com/largerio/secret/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/largerio/secret.git",
		"directory": "packages/cli"
	},
	"license": "MIT",
	"author": "Larger.io",
	"type": "module",
	"bin": {
		"secret": "./dist/cli.js"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsup",
		"typecheck": "tsc --noEmit",
		"verify-package": "sh scripts/verify-package.sh"
	},
	"dependencies": {
		"@largerio/secret-sdk": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^26.4.0",
		"tsup": "^8.5.1"
	},
	"engines": {
		"node": ">=20"
	}
}
