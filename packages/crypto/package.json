{
	"name": "@largerio/secret-crypto",
	"version": "1.0.0",
	"description": "Encryption library that powers Secret — XChaCha20-Poly1305 on the client and AES-256-GCM on the server, with Argon2id key derivation and MessagePack serialization.",
	"keywords": [
		"encryption",
		"cryptography",
		"xchacha20-poly1305",
		"aes-256-gcm",
		"argon2id",
		"libsodium",
		"zero-knowledge",
		"end-to-end-encryption",
		"privacy"
	],
	"homepage": "https://github.com/largerio/secret#readme",
	"bugs": "https://github.com/largerio/secret/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/largerio/secret.git",
		"directory": "packages/crypto"
	},
	"license": "MIT",
	"author": "Larger.io",
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": "./src/index.ts",
		"./client": "./src/client.ts",
		"./server": "./src/server.ts"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"import": "./dist/index.js"
			},
			"./client": {
				"types": "./dist/client.d.ts",
				"import": "./dist/client.js"
			},
			"./server": {
				"types": "./dist/server.d.ts",
				"import": "./dist/server.js"
			}
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@msgpack/msgpack": "^3.1.3",
		"@largerio/secret-shared": "workspace:*",
		"libsodium-wrappers-sumo": "^0.8.4"
	},
	"devDependencies": {
		"@types/node": "^25.9.1"
	}
}
