# Base image pinned by digest for reproducibility + integrity. Same base as the
# production Dockerfile: Dependabot bumps both.
FROM node:26-alpine@sha256:40cd011b55415bc894e45b02fdd5a5dfde056921b7d23a64c74f80497af48797

# Enable corepack (pnpm version comes from package.json "packageManager",
# single source of truth, matching the production Dockerfile).
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN npm install -g corepack@0.35.0 && corepack enable

WORKDIR /app

EXPOSE 5173 3000
