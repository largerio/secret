# === Encryption ===
# Server-side AES-256-GCM encryption key (32 bytes, base64).
# Leave EMPTY to have one generated automatically on first launch and persisted
# in the data volume (at .encryption_key) — zero-config start. Set it explicitly
# to control and back up the key yourself.
# Generate with: openssl rand -base64 32
# WARNING: Never change this after first deployment — all notes become inaccessible.
SERVER_ENCRYPTION_KEY=

# === Application ===
APP_NAME=Secret
# Public URL where your instance is reachable. Set this to your own domain in
# production (e.g. https://secret.example.com) — it is used for CORS, the
# OpenAPI spec, robots.txt and sitemap.xml.
APP_URL=http://localhost:3000
APP_DESCRIPTION=Secure zero-knowledge note and file sharing

# === Design / Branding ===
APP_PRIMARY_COLOR=#6366f1
APP_FOOTER_TEXT=
# Social preview image (Open Graph / Twitter card) for the home page.
# Leave empty to use the bundled default served at <APP_URL>/og.png.
# Set a full URL to use your own (recommended size: 1280x630, PNG/JPG).
APP_OG_IMAGE_URL=

# === Limits ===
MAX_FILE_SIZE=10485760
MAX_FILES_PER_NOTE=10
# Retention ceiling in seconds. Operators can only tighten it: the protocol
# maximum is 2592000 (30 days) and the minimum is 300 (5 minutes).
MAX_EXPIRY=2592000

# === API keys (optional) ===
# Grant SDK clients write access without solving a Proof-of-Work challenge.
# Minimum 32 characters. Use API_KEY_1, API_KEY_2, ... for several clients.
# API_KEY=

# === Server key rotation guard ===
# The server refuses to start if SERVER_ENCRYPTION_KEY no longer matches the key
# that encrypted the existing notes. Set this only if you accept that every
# stored note becomes permanently unreadable.
# ALLOW_SERVER_KEY_CHANGE=false

# === Server ===
# Exposed (public) port for the web app. The API runs internally on 3001 and is
# proxied by the web server — do not confuse the two; you only expose PORT.
PORT=3000
HOST=0.0.0.0

# === Database ===
DATABASE_PATH=/app/data/secret.db

# === File Storage ===
# Storage backend: "local" (default) or "s3"
STORAGE_BACKEND=local
FILES_PATH=/app/data/files

# === S3 Configuration (only when STORAGE_BACKEND=s3) ===
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT=              # For MinIO: http://minio:9000 / For R2: https://xxx.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false # Set to true for MinIO

# === SvelteKit Proxy ===
# Max request body size for the SvelteKit proxy (default: 101MB = MAX_FILE_SIZE * MAX_FILES_PER_NOTE + 1MB)
# BODY_SIZE_LIMIT=105906176

# === Chunked Upload ===
# CHUNK_SIZE=4194304            # Bytes per chunk (default: 4MB)
# MAX_CHUNKED_FILE_SIZE=524288000  # Max total upload size (default: 500MB)

# === Proof-of-Work (Cap) ===
# Difficulty of the PoW challenge browsers must solve before writing a note.
# Higher = more CPU work per request (stronger abuse resistance, slower UX).
# Recommended: 4 (balanced). Raise to 5 under sustained abuse; >6 is rejected.
# CAP_DIFFICULTY=4
# Number of sub-challenges per token. Higher = more total work. Default: 50.
# CAP_CHALLENGE_COUNT=50

# === Trusted Proxies ===
# Comma-separated list of IPs / CIDR ranges (IPv4 or IPv6) allowed to set
# X-Forwarded-For / X-Real-IP. The rate-limiter only honours these headers when
# the direct peer is in this list. Leave empty when the server is exposed
# directly (recommended default). Typical values behind a local reverse proxy:
# TRUSTED_PROXIES=127.0.0.1/32,::1/128
TRUSTED_PROXIES=

# === Cleanup ===
CLEANUP_INTERVAL_MS=300000

# === Logging ===
# Set to 1 / true to log full error objects on 500s (stack chains, cause,
# adapter context). Off by default to avoid leaking paths or credentials.
# DEBUG=0
